#!/bin/bash

RESET='\033[0m'
BOLD='\033[1m'
DIM='\033[2m'

CYAN='\033[1;36m'
BLUE='\033[1;34m'
MAGENTA='\033[1;35m'
PURPLE='\033[0;35m'
WHITE='\033[1;37m'
GREEN='\033[1;32m'

VERSION="1.0.0"
ENGINE="/data/data/com.termux/files/usr/bin/oneshot"

# ─────────────────────────────────────────────
# Clear old terminal output
# ─────────────────────────────────────────────

clear
printf '\033[3J'
printf '\033[H\033[2J'

# ─────────────────────────────────────────────
# Detect terminal width
# ─────────────────────────────────────────────

TERM_WIDTH=$(tput cols 2>/dev/null || echo 40)

# Banner width
BANNER_WIDTH=38

if [ "$TERM_WIDTH" -gt "$BANNER_WIDTH" ]; then
    SIDE_PAD=$(( (TERM_WIDTH - BANNER_WIDTH) / 2 ))
else
    SIDE_PAD=0
fi

PAD=""

for ((i=0; i<SIDE_PAD; i++)); do
    PAD+=" "
done

# ─────────────────────────────────────────────
# Centered PulseWPS Banner
# ─────────────────────────────────────────────

printf "\n"

printf "${PAD}${CYAN}╭──────────────────────────────────────╮${RESET}\n"
printf "${PAD}${CYAN}│${RESET}                                      ${CYAN}│${RESET}\n"

printf "${PAD}${CYAN}│${RESET}      ${MAGENTA}${BOLD}⚡  P U L S E W P S${RESET}       ${CYAN}│${RESET}\n"

printf "${PAD}${CYAN}│${RESET}       ${BLUE}${BOLD}W I R E L E S S${RESET}          ${CYAN}│${RESET}\n"

printf "${PAD}${CYAN}│${RESET}        ${PURPLE}${BOLD}T E S T  C O N S O L E${RESET}       ${CYAN}│${RESET}\n"

printf "${PAD}${CYAN}├──────────────────────────────────────┤${RESET}\n"

printf "${PAD}${CYAN}│${RESET}    ${GREEN}${BOLD}● READY${RESET}             ${WHITE}v${VERSION}${RESET}     ${CYAN}│${RESET}\n"

printf "${PAD}${CYAN}│${RESET}    ${MAGENTA}${BOLD}@Armanyb${RESET}                         ${CYAN}│${RESET}\n"

printf "${PAD}${CYAN}│${RESET}                                      ${CYAN}│${RESET}\n"

printf "${PAD}${CYAN}╰──────────────────────────────────────╯${RESET}\n"

printf "\n"

# ─────────────────────────────────────────────
# Information
# ─────────────────────────────────────────────

printf "${DIM}────────────────────────────────────────${RESET}\n"

printf "  ${WHITE}${BOLD}Owner${RESET}    : Arman Yb\n"
printf "  ${WHITE}${BOLD}Telegram${RESET} : @Armanyb\n"
printf "  ${WHITE}${BOLD}WhatsApp${RESET} : 8801880374287\n"

printf "${DIM}────────────────────────────────────────${RESET}\n"

printf "\n"

printf "  ${BLUE}${BOLD}PulseWPS ${VERSION}${RESET}\n"
printf "  ${GREEN}● System initialized${RESET}\n"

printf "\n"

printf "  ${WHITE}License :${RESET} Checking...\n"

# ─────────────────────────────────────────────
# Engine check
# ─────────────────────────────────────────────

if [ ! -x "$ENGINE" ]; then
    printf "\n"
    printf "  ${MAGENTA}${BOLD}[!] PulseWPS engine was not found.${RESET}\n"
    exit 1
fi

printf "  ${GREEN}● Local engine detected${RESET}\n"

printf "\n"
printf "  ${CYAN}${BOLD}Starting PulseWPS...${RESET}\n"
printf "\n"

# ─────────────────────────────────────────────
# Start local engine
# ─────────────────────────────────────────────

su -c "export HOME=/data/data/com.termux/files/home; export PATH=\$PATH:/data/data/com.termux/files/usr/bin; \"$ENGINE\" -i wlan0 -K"
